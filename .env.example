# ---------------------------------------------------------------------------
# storage-console — environment variables
# Copy this file to .env, fill in real values, then run ./deploy.sh
# ---------------------------------------------------------------------------

# ── Kubernetes ──────────────────────────────────────────────────────────────
# Namespace to deploy into (must already exist — created by homelab-cluster-setup)
HOMELAB_NAMESPACE=homelab

# ── Image ───────────────────────────────────────────────────────────────────
# Images are built locally (imagePullPolicy: Never — OrbStack k3s reuses the Mac's Docker daemon).
# Bump STORAGE_CONSOLE_TAG when you rebuild to force a rollout.
STORAGE_CONSOLE_IMAGE=storage-console
STORAGE_CONSOLE_TAG=0.1

# ── Storage paths ────────────────────────────────────────────────────────────
# Primary HDD mount — where tiered media files live (Immich / Jellyfin HDD symlinks)
HOMELAB_HDD_PATH=/Volumes/Seeni's HDD

# Secondary / tier HDD mount — used by tiering CronJobs as destination
HOMELAB_TIER_HDD_PATH=/Volumes/homelab-hdd
