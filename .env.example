# ---------------------------------------------------------------------------
# storage-console — environment variables
# Copy to .env, fill in real values, then run ./deploy.sh
# ---------------------------------------------------------------------------

# ── Kubernetes ──────────────────────────────────────────────────────────────
HOMELAB_NAMESPACE=homelab

# ── Image tags ──────────────────────────────────────────────────────────────
# Bump these when you rebuild and want immutable tag history.
# Images are built locally (imagePullPolicy: Never — OrbStack k3s reuses Mac Docker).
BACKEND_IMAGE=storage-console-backend
BACKEND_TAG=2.7
FRONTEND_IMAGE=storage-console-frontend
FRONTEND_TAG=2.3

# ── Database (shared-postgres) ──────────────────────────────────────────────
# storage-console uses the cluster's shared Postgres.
# The shared-postgres init.sh ConfigMap creates the user/DB on first
# postgres start. If you change these AFTER first start, you must also
# run the matching CREATE USER / CREATE DATABASE psql commands yourself.
STORAGE_CONSOLE_DB=storage_console
STORAGE_CONSOLE_USER=storage_console
STORAGE_CONSOLE_PASSWORD=change-me-to-real-password

# ── App secrets ──────────────────────────────────────────────────────────────
# JWT signing key — 256-bit base64.  Generate via:
#   openssl rand -base64 32
STORAGE_CONSOLE_JWT_SECRET=REPLACE-WITH-OUTPUT-OF-openssl-rand-base64-32

# Bootstrap admin — only used on first start when no admin user exists.
STORAGE_CONSOLE_ADMIN_USERNAME=admin
STORAGE_CONSOLE_ADMIN_PASSWORD=changeme
STORAGE_CONSOLE_ADMIN_DISPLAY_NAME=Admin

# ── HDD paths (mounted into mover/backup CronJob pods via hostPath) ─────────
# Tier disk (4 TB): mover destination + HDD-tiered Immich originals.
# Pre-create the subdirs: immich-library/, jellyfin-media/.
HOMELAB_TIER_HDD_PATH=/Volumes/homelab-hdd
# Backup disk (3 TB): restic repo target for the immich-backup CronJob.
# The CronJob writes the repo to ${HOMELAB_HDD_PATH}/restic-immich and ABORTS
# unless ${HOMELAB_HDD_PATH}/.homelab-backup-hdd sentinel exists (deploy.sh drops it).
HOMELAB_HDD_PATH=/Volumes/homelab-backup-hdd

# ── restic backup password (immich-backup CronJob) ──────────────────────────
# CRITICAL: if this is lost the restic repo is UNRECOVERABLE. Stored in 3 places:
#   (i)  cluster Secret restic-immich-secret  (ii) ~/.config/immich/restic-password
#   (iii) here as a placeholder (NEVER commit the real value).
# Generate via: openssl rand -base64 32
# Leave blank to make deploy.sh read ~/.config/immich/restic-password instead.
RESTIC_PASSWORD=

# ── CronJob schedules (override defaults if you want) ───────────────────────
# Cron syntax in the homelab timezone (Europe/London).
IMMICH_TIER_SCHEDULE="0 3 * * *"
JELLYFIN_TIER_SCHEDULE="0 3 * * *"
IMMICH_BACKUP_SCHEDULE="0 4 * * *"
# db-backup CronJob — restorable dumps of every homelab DB (postgres + sqlite)
# to ${HOMELAB_HDD_PATH}/backups/databases. 05:00 avoids the 03:00 tier movers
# and 04:00 immich-backup. Retention KEEP_DB=14 newest per DB (set in k8s yaml).
DB_BACKUP_SCHEDULE="0 5 * * *"
